<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================
       PAGE: MOTELS AVAILABILITY
       ========================= -->
  <template id="motels_page" name="Moteles - Disponibilidad">
    <t t-call="website.layout">

      <!-- HERO -->
      <section class="motel-hero"
               t-att-style="'background-image:url(%s)' % '/motel/static/img/motel.webp'">

        <div class="motel-hero__overlay"></div>

        <div class="container motel-hero__inner py-4">
          <h1 class="motel-hero__title text-center mb-3">Tu siguiente viaje comienza aquí</h1>

        
          <div class="motel-searchcard shadow">
            <div  class="row g-2 justify-content-center">

              <div class="col-12 col-sm-6 col-lg-4">
                <label class="motel-label" for="checkin">Entrada</label>
                <input type="date"
                       class="form-control motel-input"
                       id="checkin"
                       t-att-min="today"/>
              </div>

              <div class="col-12 col-sm-6 col-lg-4">
                <label class="motel-label" for="checkout">Salida</label>
                <input type="date"
                       class="form-control motel-input"
                       id="checkout"
                       t-att-min="today"/>
              </div>

              <div class="row mt-2">
                <div class="col-12" >
                  <div class="alert alert-warning d-none mb-0"
                     id="date_error"
                     role="alert">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- RESULTADOS (SOLO UNA VEZ) -->
      <section class="container my-4" id="motel_root">
        <div class="row g-3" id="motels_grid">

          <t t-foreach="motels" t-as="m">
            <div class="col-12 col-lg-6">
              <div class="card h-100 shadow-sm motel-card">
                <div class="card-body">

                  <h5 class="card-title mb-1">
                    <t t-esc="m.name"/>
                  </h5>

                  <div class="text-muted mb-3">
                    <t t-esc="m.display_address()"/> ·
                    <span><t t-esc="m.room_total"/> hab.</span>
                  </div>

                  <!-- NORMAL -->
                  <div class="d-flex justify-content-between border rounded p-2 mb-2 room-choice"
                       data-room-choice="normal"
                       role="button"
                       tabindex="0">
                    <div>
                      <div class="fw-semibold">Normal</div>

                      <div class="text-muted small">
                        Precio/día: <span data-price-normal="1">—</span>
                      </div>

                      <div class="text-muted small">
                        Total (<span data-nights="1">—</span> noches):
                        <strong><span data-total-normal="1">—</span></strong>
                        <span class="ms-1 text-warning d-none" data-surcharge-normal="1">(+50%)</span>
                      </div>

                      <div class="text-muted small">
                        <span class="room-choice-hint" data-hint-normal="1"></span>
                      </div>
                    </div>

                    <div class="text-end">
                      <div class="fw-semibold" data-available-normal="1">—</div>
                      <div class="text-muted small">disponibles</div>
                    </div>
                  </div>

                  <!-- PREMIUM -->
                  <div class="d-flex justify-content-between border rounded p-2 mb-3 room-choice"
                       data-room-choice="premium"
                       role="button"
                       tabindex="0">
                    <div>
                      <div class="fw-semibold">Premium</div>

                      <div class="text-muted small">
                        Precio/día: <span data-price-premium="1">—</span>
                      </div>

                      <div class="text-muted small">
                        Total (<span data-nights="1">—</span> noches):
                        <strong><span data-total-premium="1">—</span></strong>
                        <span class="ms-1 text-warning d-none" data-surcharge-premium="1">(+50%)</span>
                      </div>

                      <div class="text-muted small">
                        <span class="room-choice-hint" data-hint-premium="1"></span>
                      </div>
                    </div>

                    <div class="text-end">
                      <div class="fw-semibold" data-available-premium="1">—</div>
                      <div class="text-muted small">disponibles</div>
                    </div>
                  </div>

                  <!-- STATUS + RESERVAR -->
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-secondary" data-status="1">Selecciona fechas</span>

                    <a class="btn btn-primary disabled"
                       role="button"
                       aria-disabled="true"
                       data-action-reserve="1"
                       href="#">
                      Reservar
                    </a>
                  </div>

                  <!-- ID motel (NO hardcode) -->
                  <input type="hidden"
                         data-motel-id="1"
                         t-att-value="m.id"/>

                </div>
              </div>
            </div>
          </t>

        </div>
      </section>
    </t>
  </template>


  <!-- =========================
       PAGE: RESERVE
       ========================= -->
  <template id="reserve_page" name="Reserve Motel">
    <t t-call="website.layout">
      <div class="container my-4" id="motel_reserve_root">
        <h2>Reservar sin cuenta</h2>

        <p t-if="motel">
          <strong>Motel:</strong> <t t-esc="motel.name"/> — <t t-esc="motel.display_address()"/>
        </p>

        <p class="text-muted mb-2">
          Fechas: <strong><t t-esc="checkin"/></strong> → <strong><t t-esc="checkout"/></strong>
        </p>

        <t t-if="pricing">
          <div class="alert alert-info mt-3" role="alert"
            id="pricing_box"
            t-att-data-nights="pricing.get('nights')"
            t-att-data-base-per-day="pricing.get('base_per_day')"
            t-att-data-base-total="pricing.get('base_total')"
            t-att-data-surcharge="1 if pricing.get('surcharge_applied') else 0"
            data-long-mult="1.5"
            data-pet-flat="25"
            data-wifi-per-night="2">

            <div class="d-flex justify-content-between flex-wrap gap-2">
              <span><strong>Tipo:</strong> <t t-esc="pricing.get('room_type')"/></span>
              <span><strong>Noches:</strong> <t t-esc="pricing.get('nights')"/></span>
            </div>

            <div class="d-flex justify-content-between flex-wrap gap-2">
              <span><strong>Precio base/día:</strong> $<t t-esc="pricing.get('base_per_day')"/></span>
              <span><strong>Base total:</strong> $<t t-esc="pricing.get('base_total')"/></span>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span>
                <strong>Recargo estancia larga:</strong>
                <t t-esc="'Sí (+50%)' if pricing.get('surcharge_applied') else 'No'"/>
              </span>
              <span class="fs-6">
                <strong>Subtotal:</strong> $<span id="ui_subtotal">0.00</span>
              </span>
            </div>
            
            <hr class="my-2"/>

            <!-- Extras: uno debajo del otro -->
            <div class="d-flex flex-column gap-1">
              <div>
                <span><strong>Mascotas:</strong></span>
                <span>$<span id="ui_pet_fee">0.00</span></span>
              </div>

              <div>
                <span><strong>Wi-Fi:</strong></span>
                <span>$<span id="ui_wifi_fee">0.00</span></span>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
              <span class="fs-5">
                <strong>Total final:</strong> $<span id="ui_final_total">0.00</span>
              </span>
            </div>

          </div>
        </t>

        <t t-else="">
          <div class="alert alert-warning mt-3" role="alert">
            No se pudo calcular el precio. Verifica fechas y tipo de habitación.
          </div>
        </t>

        <p class="text-muted">
          ¿Ya tienes cuenta? <a t-att-href="login_url">Inicia sesión</a> (opcional)
        </p>

        <t t-if="errors">
          <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
              <t t-foreach="errors.items()" t-as="e">
                <li><t t-esc="e[1]"/></li>
              </t>
            </ul>
          </div>
        </t>

        <form action="/motels/confirm" method="post" class="mt-3">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

          <input type="hidden" name="motel_id" t-att-value="motel.id if motel else ''"/>
          <input type="hidden" name="room_type" t-att-value="room_type"/>
          <input type="hidden" name="checkin" t-att-value="checkin"/>
          <input type="hidden" name="checkout" t-att-value="checkout"/>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="first_name">Nombre(s)*</label>
              <input id="first_name" class="form-control" name="first_name"
                     t-att-value="prefill.get('first') if prefill else ''"
                     required="required"/>
              <small class="text-danger" t-if="errors and errors.get('first_name')">
                <t t-esc="errors.get('first_name')"/>
              </small>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="last_name">Apellidos*</label>
              <input id="last_name" class="form-control" name="last_name"
                     t-att-value="prefill.get('last') if prefill else ''"
                     required="required"/>
              <small class="text-danger" t-if="errors and errors.get('last_name')">
                <t t-esc="errors.get('last_name')"/>
              </small>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="email">Email*</label>
              <input id="email" class="form-control" name="email" type="email"
                     t-att-value="prefill.get('email') if prefill else ''"
                     required="required"/>
              <small class="text-danger" t-if="errors and errors.get('email')">
                <t t-esc="errors.get('email')"/>
              </small>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="phone">Teléfono*</label>
              <input id="phone" class="form-control" name="phone"
                     t-att-value="prefill.get('phone') if prefill else ''"
                     required="required"/>
              <small class="text-danger" t-if="errors and errors.get('phone')">
                <t t-esc="errors.get('phone')"/>
              </small>
            </div>

            <div class="col-12">
              <div class="card border-0 shadow-sm">
                <div class="card-body">
                  <h5 class="mb-3">Extras</h5>

                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="has_pets" id="has_pets"
                          t-att-checked="prefill.get('has_pets') if prefill else False"/>
                    <label class="form-check-label" for="has_pets">
                      Llevo mascota (+ $25.00 por reserva)
                    </label>
                  </div>

                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="wants_wifi" id="wants_wifi"
                          t-att-checked="prefill.get('wants_wifi') if prefill else False"/>
                    <label class="form-check-label" for="wants_wifi">
                      Quiero Wi-Fi en la habitación (+ $2.00 por noche)
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="terms" id="terms"
                       t-att-checked="prefill.get('terms') if prefill else False"/>
                <label class="form-check-label" for="terms">
                  Acepto Términos y Condiciones*
                </label>
              </div>
              <small class="text-danger" t-if="errors and errors.get('terms')">
                <t t-esc="errors.get('terms')"/>
              </small>
            </div>

            <div class="col-12">
              <button class="btn btn-primary" type="submit" t-att-disabled="not pricing">
                Confirmar reserva
              </button>
              <a class="btn btn-secondary ms-2" href="/motels">Volver</a>
            </div>
          </div>
        </form>
      </div>
    </t>
  </template>


  <!-- =========================
       PAGE: RESERVE ERROR
       ========================= -->
  <template id="reserve_error" name="Reserve Error">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="alert alert-danger" role="alert">
          <h4 class="mb-2">No se pudo confirmar</h4>
          <p class="mb-2"><t t-esc="message"/></p>
          <p class="text-muted mb-0">
            ID de intento: <strong><t t-esc="attempt_uuid"/></strong>
          </p>
        </div>
        <a class="btn btn-primary" href="/motels">Volver a moteles</a>
      </div>
    </t>
  </template>


  <!-- =========================
       PAGE: CONFIRMATION
       ========================= -->
  <template id="confirmation_page" name="Reservation Confirmed">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="alert alert-success" role="alert">
          <h3 class="mb-2">Reserva confirmada</h3>
          <p class="mb-2">Tu folio es: <strong><t t-esc="reservation.reference"/></strong></p>

          <p class="mb-2">
            Motel: <strong><t t-esc="reservation.motel_id.name"/></strong> —
            Habitación: <strong><t t-esc="reservation.room_id.name"/></strong><br/>
            Fechas: <t t-esc="reservation.checkin_date"/> → <t t-esc="reservation.checkout_date"/>
          </p>

          <div class="border-top pt-3 mt-3">
            <div class="d-flex justify-content-between flex-wrap gap-2">
              <span><strong>Tipo:</strong> <t t-esc="reservation.room_type_code"/></span>
              <span><strong>Noches:</strong> <t t-esc="reservation.nights"/></span>
            </div>
            <div class="d-flex justify-content-between flex-wrap gap-2">
              <span><strong>Base/día:</strong> $<t t-esc="reservation.base_price_per_day"/></span>
              <span><strong>Base total:</strong> $<t t-esc="reservation.base_total"/></span>
            </div>
            <div class="d-flex justify-content-between flex-wrap gap-2">
              <span>
                <strong>Recargo:</strong>
                <t t-esc="'Sí (+50%)' if reservation.surcharge_applied else 'No'"/>
              </span>
              <span class="fs-5"><strong>Total:</strong> $<t t-esc="reservation.final_total"/></span>
            </div>
          </div>
        </div>

        <a class="btn btn-primary" href="/motels">Volver a moteles</a>
      </div>
    </t>
  </template>

  <template id="payment_page" name="Payment - Advance Only">
    <t t-call="website.layout">
      <div class="container my-5">
        <h3>Pago anticipado</h3>
        <div class="alert alert-info">
          En la web solo se permite pago anticipado.
        </div>

        <p>
          Folio (a generar al pagar): <strong>Pendiente</strong><br/>
          Total: <strong>$<t t-esc="reservation.final_total"/></strong>
        </p>

        <div class="d-flex flex-wrap gap-2">
          <form action="/motels/pay/submit" method="post" class="d-inline">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="attempt_uuid" t-att-value="reservation.attempt_uuid"/>
            <button class="btn btn-primary" type="submit">Pagar ahora</button>
          </form>

          <form action="/motels/pay/reception" method="post" class="d-inline">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="attempt_uuid" t-att-value="reservation.attempt_uuid"/>
            <button class="btn btn-outline-secondary" type="submit">Pagar en recepción</button>
          </form>

          <a class="btn btn-secondary" href="/motels">Cancelar</a>
        </div>
      </div>
    </t>
  </template>

  <template id="pending_payment_page" name="Pending Payment">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="alert alert-warning" role="alert">
          <h4 class="mb-2">Reserva creada — Pendiente de pago en recepción</h4>
          <p class="mb-2">Tu folio es: <strong><t t-esc="reservation.reference"/></strong></p>
          <p class="mb-0">
            Presenta este folio en recepción para completar el pago.
          </p>
        </div>
        <a class="btn btn-primary" href="/motels">Volver a moteles</a>
      </div>
    </t>
  </template>


  <template id="payment_failed_page" name="Payment Failed">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="alert alert-danger">
          <h4>El pago no pudo completarse</h4>
          <p>Tu reserva no se ha confirmado. Puedes reintentar el pago.</p>
          <p class="text-muted mb-0">
            ID correlación: <strong><t t-esc="reservation.payment_correlation_id"/></strong>
          </p>
        </div>
        <a class="btn btn-primary" t-att-href="'/motels/pay/%s' % reservation.attempt_uuid">Reintentar pago</a>
        <a class="btn btn-secondary ms-2" href="/motels">Volver</a>
      </div>
    </t>
  </template>
  <!-- =========================
       PAGE: CANCELLATION (QUOTE + CONFIRM)
       HU-05 CA-03
       Seguridad: token attempt_uuid + email match
       ========================= -->
  <template id="cancel_page" name="Cancel Reservation">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="alert alert-warning" role="alert">
          <h3 class="mb-2">Cancelar reserva</h3>
          <p class="mb-0">
            Para proteger tu reserva, confirma tu email antes de cancelar.
          </p>
        </div>

        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="mb-3">Resumen de la reserva</h5>

            <p class="mb-2">
              <strong>Folio:</strong> <t t-esc="reservation.reference"/><br/>
              <strong>Motel:</strong> <t t-esc="reservation.motel_id.name"/> —
              <strong>Habitación:</strong> <t t-esc="reservation.room_id.name"/><br/>
              <strong>Fechas:</strong>
              <t t-esc="reservation.checkin_date"/> → <t t-esc="reservation.checkout_date"/>
            </p>

            <div class="border-top pt-3 mt-3">
              <h5 class="mb-3">Política aplicada</h5>

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <span><strong>% reembolso:</strong></span>
                <span class="fw-semibold">
                  <t t-esc="quote.get('refund_percentage')"/>%
                </span>
              </div>

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <span><strong>Total pagado:</strong></span>
                <span>$<t t-esc="('%.2f' % (quote.get('total_paid') or 0.0))"/></span>
              </div>

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <span><strong>Monto a devolver:</strong></span>
                <span class="fw-semibold">$<t t-esc="('%.2f' % (quote.get('refund_amount') or 0.0))"/></span>
              </div>

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <span><strong>Monto retenido:</strong></span>
                <span>$<t t-esc="('%.2f' % (quote.get('retained_amount') or 0.0))"/></span>
              </div>

              <div class="alert alert-info mt-3 mb-0" role="alert">
                <t t-esc="quote.get('message')"/>
              </div>
            </div>

            <!-- Errores (email mismatch, etc.) -->
            <t t-if="error">
              <div class="alert alert-danger mt-3" role="alert">
                <t t-esc="error"/>
              </div>
            </t>

            <form action="/motels/cancel/confirm" method="post" class="mt-4">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="attempt_uuid" t-att-value="reservation.attempt_uuid"/>
              <input type="hidden" name="confirm" value="yes"/>

              <div class="row g-3 align-items-end">
                <div class="col-12 col-md-7">
                  <label class="form-label" for="cancel_email">
                    Confirma tu email (debe coincidir con el de la reserva)*
                  </label>
                  <input id="cancel_email"
                         class="form-control"
                         type="email"
                         name="email"
                         required="required"
                         t-att-value="email_prefill or ''"
                         placeholder="tuemail@dominio.com"/>
                  <small class="text-muted">
                    Esto evita cancelaciones si alguien conoce el folio.
                  </small>
                </div>

                <div class="col-12 col-md-5 text-md-end">
                  <button class="btn btn-danger" type="submit">
                    Confirmar cancelación
                  </button>
                  <a class="btn btn-outline-secondary ms-2"
                     t-att-href="'/motels/confirmation/%s' % reservation.reference">
                    Volver
                  </a>
                </div>
              </div>
            </form>

          </div>
        </div>
      </div>
    </t>
  </template>


  <!-- =========================
       PAGE: CANCELLED (RESULT)
       HU-05 CA-05 / CA-06
       ========================= -->
  <template id="cancelled_page" name="Reservation Cancelled">
    <t t-call="website.layout">
      <div class="container my-5">

        <div class="alert alert-secondary" role="alert">
          <h3 class="mb-2">Reserva cancelada</h3>
          <p class="mb-0">
            Folio: <strong><t t-esc="reservation.reference"/></strong>
          </p>
        </div>

        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="mb-3">Detalle</h5>

            <p class="mb-2">
              <strong>Motel:</strong> <t t-esc="reservation.motel_id.name"/> —
              <strong>Habitación:</strong> <t t-esc="reservation.room_id.name"/><br/>
              <strong>Fechas:</strong>
              <t t-esc="reservation.checkin_date"/> → <t t-esc="reservation.checkout_date"/>
            </p>

            <div class="border-top pt-3 mt-3">
              <div class="d-flex justify-content-between flex-wrap gap-2">
                <span><strong>Estado:</strong></span>
                <span class="badge bg-dark text-uppercase">
                  <t t-esc="reservation.state"/>
                </span>
              </div>

              <div class="d-flex justify-content-between flex-wrap gap-2 mt-2">
                <span><strong>Estado financiero:</strong></span>
                <span class="badge bg-primary text-uppercase">
                  <t t-esc="reservation.financial_state"/>
                </span>
              </div>

              <div class="d-flex justify-content-between flex-wrap gap-2 mt-2">
                <span><strong>% aplicado:</strong></span>
                <span><t t-esc="reservation.refund_percentage"/>%</span>
              </div>

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <span><strong>Monto reembolsado:</strong></span>
                <span class="fw-semibold">$<t t-esc="reservation.refund_amount"/></span>
              </div>

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <span><strong>Monto retenido:</strong></span>
                <span>$<t t-esc="reservation.non_refundable_amount"/></span>
              </div>

              <t t-if="reservation.refund_reference">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                  <span><strong>Referencia de reembolso:</strong></span>
                  <span><t t-esc="reservation.refund_reference"/></span>
                </div>
              </t>

              <div class="text-muted small mt-2">
                Cancelada el:
                <t t-esc="reservation.cancelled_at"/>
              </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
              <a class="btn btn-primary" href="/motels">Volver a moteles</a>
              <a class="btn btn-outline-secondary"
                 t-att-href="'/motels/cancel/%s' % reservation.attempt_uuid">
                Ver política aplicada
              </a>
            </div>

          </div>
        </div>

      </div>
    </t>
  </template>
  
  <template id="motels_map_page" name="Mapa de moteles">
    <t t-call="website.layout">
      <section class="container my-4" id="motel_map_root">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <h2 class="mb-0">Mapa de moteles</h2>
          <a class="btn btn-outline-primary" href="/motels">Ver lista</a>
        </div>

        <div id="map_status" class="alert alert-info" role="status">
          Cargando mapa…
        </div>

        <div id="map_error" class="alert alert-danger d-none" role="alert">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span id="map_error_msg">No se pudo cargar el mapa.</span>
            <button id="map_retry" class="btn btn-sm btn-light" type="button">Reintentar</button>
          </div>
        </div>

        <div id="map_empty" class="alert alert-warning d-none" role="status">
          No hay moteles disponibles.
        </div>

        <div id="motels_map" class="motel-map" aria-label="Mapa interactivo de moteles"></div>
      </section>
    </t>
  </template>
  

</odoo>
