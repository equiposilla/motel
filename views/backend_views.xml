<odoo>
    <!--  =========================
           MENÚ RAÍZ
           =========================  -->
    <menuitem id="menu_motel_root" name="Motel" sequence="60"/>

    <!--  =========================
           MOTEL.MOTEL (Moteles) ✅ con geo_picker
           =========================  -->
    <record id="view_motel_motel_list" model="ir.ui.view">
        <field name="name">motel.motel.list</field>
        <field name="model">motel.motel</field>
        <field name="arch" type="xml">
            <list string="Moteles">
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="latitude"/>
                <field name="longitude"/>
            </list>
        </field>
    </record>

    <record id="view_motel_motel_form" model="ir.ui.view">
        <field name="name">motel.motel.form</field>
        <field name="model">motel.motel</field>
        <field name="arch" type="xml">
            <form string="Motel">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Geolocalización">
                            <!-- ✅ selector en mapa -->
                            <field name="latitude" widget="geo_picker" options="{'lng_field': 'longitude'}"/>
                            <field name="longitude" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_motel_motel" model="ir.actions.act_window">
        <field name="name">Moteles</field>
        <field name="res_model">motel.motel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_motel_motel"
              name="Moteles"
              parent="menu_motel_root"
              action="action_motel_motel"
              sequence="5"/>

    <!--  =========================
            RESERVATIONS (motel.reservation) ✅ FULL
            =========================  -->
    <record id="view_motel_reservation_list" model="ir.ui.view">
        <field name="name">motel.reservation.list</field>
        <field name="model">motel.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations">
                <field name="reference"/>
                <field name="state"/>
                <field name="motel_id"/>
                <field name="room_id"/>
                <field name="room_type_code"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="nights"/>
                <field name="has_pets"/>
                <field name="wants_wifi"/>
                <field name="pet_fee"/>
                <field name="wifi_fee_total"/>
                <field name="channel"/>
                <field name="payment_method"/>
                <field name="payment_state"/>
                <field name="final_total"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_motel_reservation_form" model="ir.ui.view">
        <field name="name">motel.reservation.form</field>
        <field name="model">motel.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <sheet>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>

                        <button name="action_register_on_site_payment"
                                type="object"
                                string="Registrar cobro"
                                class="btn-primary"
                                invisible="channel != 'reception' or payment_method != 'on_site' or payment_state == 'paid'"/>

                        <button name="action_open_cancel_wizard"
                                type="object"
                                string="Cancelar (política)"
                                class="btn-danger"
                                invisible="state == 'cancelled'"/>
                    </header>

                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="attempt_uuid" readonly="1"/>
                            <field name="motel_id" readonly="1"/>
                            <field name="room_id"/>
                            <field name="room_type_code"/>
                        </group>
                        <group>
                            <field name="checkin_date"/>
                            <field name="checkout_date"/>
                            <field name="nights" readonly="1"/>
                            <field name="currency_id" groups="base.group_system"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Guest">
                            <group>
                                <group>
                                    <field name="partner_id"/>
                                    <field name="guest_first_name"/>
                                    <field name="guest_last_name"/>
                                </group>
                                <group>
                                    <field name="guest_email"/>
                                    <field name="guest_phone"/>
                                    <field name="terms_accepted"/>
                                </group>
                            </group>
                        </page>

                        <page string="Pricing">
                            <group>
                                <group>
                                    <field name="base_price_per_day" readonly="1"/>
                                    <field name="base_total" readonly="1"/>
                                </group>
                                <group>
                                    <field name="surcharge_applied" readonly="1"/>
                                    <field name="final_total" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Sales">
                            <group>
                                <field name="sale_order_id"/>
                            </group>
                        </page>

                        <page string="Payment">
                            <group>
                                <group>
                                    <field name="channel"/>
                                    <field name="payment_method"/>
                                    <field name="payment_state" readonly="1"/>
                                </group>
                                <group>
                                    <field name="payment_reference" readonly="1"/>
                                    <field name="payment_correlation_id" readonly="1"/>
                                    <field name="paid_at" readonly="1"/>
                                    <field name="paid_by_user_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Cancellation">
                            <!-- PREVIEW (antes de cancelar) -->
                            <group string="Preview (antes de cancelar)" invisible="state == 'cancelled'">
                                <div class="alert alert-info" role="alert">
                                    <field name="refund_quote_message" nolabel="1" readonly="1"/>
                                </div>
                                <group>
                                    <group>
                                        <field name="amount_paid" readonly="1"/>
                                        <field name="refund_quote_percentage" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="refund_quote_amount" readonly="1"/>
                                        <field name="retained_quote_amount" readonly="1"/>
                                    </group>
                                </group>
                            </group>

                            <!-- APLICADO (auditoría, después de cancelar) -->
                            <group string="Aplicado (auditoría)" invisible="state != 'cancelled'">
                                <group>
                                    <group>
                                        <field name="cancelled_at" readonly="1"/>
                                        <field name="cancelled_by_user_id" readonly="1"/>
                                        <field name="cancelled_channel" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="financial_state" readonly="1"/>
                                        <field name="refund_percentage" readonly="1"/>
                                        <field name="refund_reference" readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <field name="amount_paid" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="refund_amount" readonly="1"/>
                                        <field name="non_refundable_amount" readonly="1"/>
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--  =========================
             HU-05: Cancel Wizard (Backoffice)
             =========================  -->
    <record id="view_motel_reservation_cancel_wizard_form" model="ir.ui.view">
        <field name="name">motel.reservation.cancel.wizard.form</field>
        <field name="model">motel.reservation.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancelar reserva">
                <sheet>
                    <group>
                        <field name="reservation_id" readonly="1"/>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <field name="message" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group>
                            <field name="refund_percentage" readonly="1"/>
                            <field name="total_paid" readonly="1"/>
                        </group>
                        <group>
                            <field name="refund_amount" readonly="1"/>
                            <field name="retained_amount" readonly="1"/>
                        </group>
                    </group>

                    <footer>
                        <button string="Confirmar cancelación"
                                type="object"
                                name="action_confirm_cancel"
                                class="btn-primary"/>
                        <button string="Cerrar" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_motel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">motel.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea y gestiona reservas de habitaciones.</p>
        </field>
    </record>

    <menuitem id="menu_motel_reservation"
              name="Reservations"
              parent="menu_motel_root"
              action="action_motel_reservation"
              sequence="10"/>

    <!--  =========================
            PAYMENT LOGS (motel.payment.log) ✅ FULL
            =========================  -->
    <record id="view_motel_payment_log_list" model="ir.ui.view">
        <field name="name">motel.payment.log.list</field>
        <field name="model">motel.payment.log</field>
        <field name="arch" type="xml">
            <list string="Payment Logs" create="0" edit="0">
                <field name="create_date"/>
                <field name="reservation_id"/>
                <field name="channel"/>
                <field name="action"/>
                <field name="state"/>
                <field name="correlation_id"/>
                <field name="provider_reference"/>
                <field name="performed_by_user_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_motel_payment_log_form" model="ir.ui.view">
        <field name="name">motel.payment.log.form</field>
        <field name="model">motel.payment.log</field>
        <field name="arch" type="xml">
            <form string="Payment Log" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="channel"/>
                            <field name="action"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="performed_by_user_id"/>
                            <field name="correlation_id"/>
                            <field name="provider_reference"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_motel_payment_log_search" model="ir.ui.view">
        <field name="name">motel.payment.log.search</field>
        <field name="model">motel.payment.log</field>
        <field name="arch" type="xml">
            <search string="Payment Logs">
                <field name="reservation_id"/>
                <field name="correlation_id"/>
                <field name="provider_reference"/>
                <field name="performed_by_user_id"/>
                <filter string="Web" name="filter_web" domain="[('channel','=','web')]"/>
                <filter string="Reception" name="filter_reception" domain="[('channel','=','reception')]"/>
                <separator/>
                <filter string="Paid" name="filter_paid" domain="[('state','=','paid')]"/>
                <filter string="Pending" name="filter_pending" domain="[('state','=','pending')]"/>
                <filter string="Failed" name="filter_failed" domain="[('state','=','failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_motel_payment_log" model="ir.actions.act_window">
        <field name="name">Payment Logs</field>
        <field name="res_model">motel.payment.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="motel.view_motel_payment_log_search"/>
    </record>

    <menuitem id="menu_motel_payment_log"
              name="Payment Logs"
              parent="menu_motel_root"
              action="action_motel_payment_log"
              sequence="20"/>
</odoo>
