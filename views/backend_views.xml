<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================
       MENÚ RAÍZ
       ========================= -->
  <menuitem id="menu_motel_root" name="Motel" sequence="60"/>

  <!-- =========================
       MOTEL.MOTEL (Moteles)  ✅ AQUÍ ENTRAS A PONER COORDENADAS
       ========================= -->

  <!-- List -->
  <record id="view_motel_motel_list" model="ir.ui.view">
    <field name="name">motel.motel.list</field>
    <field name="model">motel.motel</field>
    <field name="arch" type="xml">
      <list string="Moteles">
        <field name="name"/>
        <field name="city"/>
        <field name="country_id"/>
        <field name="latitude"/>
        <field name="longitude"/>
      </list>
    </field>
  </record>

  <!-- Form -->
  <record id="view_motel_motel_form" model="ir.ui.view">
    <field name="name">motel.motel.form</field>
    <field name="model">motel.motel</field>
    <field name="arch" type="xml">
      <form string="Motel">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="street"/>
              <field name="city"/>
              <field name="country_id"/>
            </group>

            <group string="Geolocalización">
              <!-- ✅ este es el campo que te deja elegir en mapa -->
              <field name="latitude" widget="geo_picker" options="{'lng_field': 'longitude'}"/>
              <field name="longitude" invisible="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_motel_motel" model="ir.actions.act_window">
    <field name="name">Moteles</field>
    <field name="res_model">motel.motel</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_motel_motel"
            name="Moteles"
            parent="menu_motel_root"
            action="action_motel_motel"
            sequence="5"/>

  <!-- =========================
       RESERVATIONS (motel.reservation)
       ========================= -->

  <record id="view_motel_reservation_list" model="ir.ui.view">
    <field name="name">motel.reservation.list</field>
    <field name="model">motel.reservation</field>
    <field name="arch" type="xml">
      <list string="Reservations">
        <field name="reference"/>
        <field name="state"/>
        <field name="motel_id"/>
        <field name="room_id"/>
        <field name="room_type_code"/>
        <field name="checkin_date"/>
        <field name="checkout_date"/>
        <field name="nights"/>
        <field name="has_pets"/>
        <field name="wants_wifi"/>
        <field name="pet_fee"/>
        <field name="wifi_fee_total"/>
        <field name="channel"/>
        <field name="payment_method"/>
        <field name="payment_state"/>
        <field name="final_total"/>
        <field name="partner_id"/>
        <field name="sale_order_id"/>
      </list>
    </field>
  </record>

  <record id="view_motel_reservation_form" model="ir.ui.view">
    <field name="name">motel.reservation.form</field>
    <field name="model">motel.reservation</field>
    <field name="arch" type="xml">
      <form string="Reservation">
        <sheet>
          <header>
            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
          </header>

          <group>
            <group>
              <field name="reference" readonly="1"/>
              <field name="attempt_uuid" readonly="1"/>
              <field name="motel_id" readonly="1"/>
              <field name="room_id"/>
              <field name="room_type_code"/>
            </group>
            <group>
              <field name="checkin_date"/>
              <field name="checkout_date"/>
              <field name="nights" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Guest">
              <group>
                <group>
                  <field name="partner_id"/>
                  <field name="guest_first_name"/>
                  <field name="guest_last_name"/>
                </group>
                <group>
                  <field name="guest_email"/>
                  <field name="guest_phone"/>
                  <field name="terms_accepted"/>
                </group>
              </group>
            </page>

            <page string="Pricing">
              <group>
                <group>
                  <field name="base_price_per_day" readonly="1"/>
                  <field name="base_total" readonly="1"/>
                </group>
                <group>
                  <field name="surcharge_applied" readonly="1"/>
                  <field name="final_total" readonly="1"/>
                </group>
              </group>
            </page>

            <page string="Payment">
              <group>
                <group>
                  <field name="channel"/>
                  <field name="payment_method"/>
                  <field name="payment_state" readonly="1"/>
                </group>
                <group>
                  <field name="payment_reference" readonly="1"/>
                  <field name="payment_correlation_id" readonly="1"/>
                  <field name="paid_at" readonly="1"/>
                  <field name="paid_by_user_id" readonly="1"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_motel_reservation" model="ir.actions.act_window">
    <field name="name">Reservations</field>
    <field name="res_model">motel.reservation</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_motel_reservation"
            name="Reservations"
            parent="menu_motel_root"
            action="action_motel_reservation"
            sequence="10"/>

  <!-- =========================
       PAYMENT LOGS (motel.payment.log)
       ========================= -->

  <record id="view_motel_payment_log_list" model="ir.ui.view">
    <field name="name">motel.payment.log.list</field>
    <field name="model">motel.payment.log</field>
    <field name="arch" type="xml">
      <list string="Payment Logs" create="0" edit="0">
        <field name="create_date"/>
        <field name="reservation_id"/>
        <field name="channel"/>
        <field name="action"/>
        <field name="state"/>
        <field name="correlation_id"/>
        <field name="provider_reference"/>
        <field name="performed_by_user_id"/>
        <field name="note"/>
      </list>
    </field>
  </record>

  <record id="action_motel_payment_log" model="ir.actions.act_window">
    <field name="name">Payment Logs</field>
    <field name="res_model">motel.payment.log</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_motel_payment_log"
            name="Payment Logs"
            parent="menu_motel_root"
            action="action_motel_payment_log"
            sequence="20"/>

</odoo>
