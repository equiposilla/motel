<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="motel.GeoPickerField" owl="1">
    <div class="o_geo_picker">
      <div class="d-flex gap-2 mb-2">
        <button type="button" class="btn btn-secondary btn-sm" t-on-click="onClearLocation">
          Limpiar ubicación
        </button>
        <span class="text-muted small align-self-center">
          Click en el mapa para colocar el pin.
        </span>
      </div>
      <div class="o_geo_picker_map" style="height: 320px; border-radius: 8px; overflow: hidden;"></div>
    </div>
  </t>
</templates>
